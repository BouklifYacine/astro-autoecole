---
import { autoecole } from '@/lib/autoecole';
import SectionHeading from './SectionHeading.astro';

const { faq } = autoecole;
---

<section id="faq" class="section-space bg-surface scroll-mt-20">
  <div class="container-shell">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <SectionHeading eyebrow="Questions" title="Les questions qu’on nous pose vraiment." class="mb-0" />
        <p class="mt-4 text-[0.95rem] text-muted-foreground">
          Une question qui n’est pas là ? Le téléphone reste le moyen le plus rapide.
        </p>
      </div>

      <!--
        Real buttons with aria-expanded / aria-controls rather than <details>, and
        every panel is rendered OPEN in the HTML. The script below closes them on
        load, so a visitor without JavaScript reads the full FAQ instead of
        nothing. Progressive enhancement, not a JS-only accordion.
      -->
      <div class="lg:col-span-8" data-faq>
        {
          faq.map((item, index) => (
            <div class="border-t border-(--color-border) last:border-b">
              <h3>
                <button
                  type="button"
                  id={`faq-trigger-${index}`}
                  aria-expanded="true"
                  aria-controls={`faq-panel-${index}`}
                  class="flex w-full items-start justify-between gap-4 py-5 text-left font-heading text-base font-semibold text-ink"
                >
                  {item.question}
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 16 16"
                    fill="none"
                    class="mt-1 size-4 shrink-0 text-muted-foreground transition-transform duration-200"
                    data-faq-chevron
                  >
                    <path
                      d="m4 6 4 4 4-4"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
              </h3>

              <div id={`faq-panel-${index}`} role="region" aria-labelledby={`faq-trigger-${index}`}>
                <p class="pb-5 text-[0.95rem] text-muted-foreground">{item.answer}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-faq]')) {
    const triggers = root.querySelectorAll<HTMLButtonElement>('button[aria-controls]');

    for (const [index, trigger] of triggers.entries()) {
      const panelId = trigger.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      if (!panel) continue;

      const chevron = trigger.querySelector<SVGElement>('[data-faq-chevron]');

      const setOpen = (open: boolean) => {
        trigger.setAttribute('aria-expanded', String(open));
        panel.hidden = !open;
        chevron?.classList.toggle('rotate-180', open);
      };

      // First answer stays open: an accordion where everything is shut reads as
      // an empty section on a first visit.
      setOpen(index === 0);
      trigger.addEventListener('click', () => {
        setOpen(trigger.getAttribute('aria-expanded') !== 'true');
      });
    }
  }
</script>
