---
import { autoecole } from '@/lib/autoecole';
import SectionHeading from './SectionHeading.astro';
import Cta from './Cta.astro';

const { tarifs } = autoecole;

const euros = new Intl.NumberFormat('fr-FR', {
  style: 'currency',
  currency: 'EUR',
  maximumFractionDigits: 0,
});
---

<section id="tarifs" class="section-space bg-surface scroll-mt-20">
  <div class="container-shell">
    <SectionHeading eyebrow="Tarifs" title="Ce qui est compris, et ce qui ne l’est pas." lead={tarifs.intro} />

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        tarifs.formules.map((formule) => (
          <li
            class:list={[
              'surface-card flex flex-col p-6',
              formule.featured && 'border-brand ring-1 ring-brand',
            ]}
          >
            {formule.featured && (
              <span class="mb-3 self-start rounded-full bg-brand-tint px-2.5 py-1 text-xs font-medium text-brand-hover">
                Le plus choisi
              </span>
            )}

            <h3 class="font-heading text-lg font-semibold text-ink">{formule.name}</h3>
            <p class="mt-1.5 min-h-10 text-sm text-muted-foreground">{formule.pitch}</p>

            <p class="mt-5 flex items-baseline gap-1.5">
              <span class="font-heading text-3xl font-semibold text-ink">
                {euros.format(formule.price)}
              </span>
              <span class="text-sm text-muted-foreground">{formule.unit}</span>
            </p>

            <ul class="mt-5 space-y-2 border-t border-(--color-border) pt-5 text-sm">
              {formule.includes.map((item) => (
                <li class="flex items-start gap-2">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 16 16"
                    fill="none"
                    class="mt-0.5 size-4 shrink-0 text-success"
                  >
                    <path
                      d="m3.5 8.5 3 3 6-7"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span class="text-ink">{item}</span>
                </li>
              ))}

              {/* Hiding the exclusions is what makes a price list feel like a trap. */}
              {formule.excludes.map((item) => (
                <li class="flex items-start gap-2">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 16 16"
                    fill="none"
                    class="mt-0.5 size-4 shrink-0 text-muted-foreground"
                  >
                    <path
                      d="M4 8h8"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                    />
                  </svg>
                  <span class="text-muted-foreground">Non compris : {item}</span>
                </li>
              ))}
            </ul>

            <div class="mt-auto pt-6">
              <Cta
                href="#reservation"
                label="Choisir cette formule"
                variant={formule.featured ? 'primary' : 'secondary'}
                class="w-full"
              />
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 grid gap-8 lg:grid-cols-2 lg:gap-14">
      <div>
        <h3 class="font-heading text-base font-semibold text-ink">À l’unité</h3>
        <dl class="mt-4">
          {
            tarifs.options.map((option) => (
              <div class="flex items-baseline justify-between gap-4 border-t border-(--color-border) py-3">
                <dt class="text-[0.95rem] text-ink">{option.label}</dt>
                <dd class="shrink-0 font-medium text-ink tabular-nums">
                  {euros.format(option.price)}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div>
        <h3 class="font-heading text-base font-semibold text-ink">Conditions</h3>
        <ul class="mt-4 space-y-3">
          {
            tarifs.conditions.map((condition) => (
              <li class="border-t border-(--color-border) pt-3 text-[0.95rem] text-muted-foreground">
                {condition}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
