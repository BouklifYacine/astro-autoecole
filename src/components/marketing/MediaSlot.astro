---
import type { MediaSlotData } from '@/content/schemas';

/**
 * A photo that does not exist yet.
 *
 * The references this page is built on are image-led, and collapsing them into a
 * text-only layout would lose the thing that makes them work. So the slot keeps
 * its exact space in the composition, states its aspect ratio, and carries the
 * art direction for whoever shoots it.
 *
 * What it deliberately does NOT do: fake a photograph with gradients or shapes,
 * or pass a generated portrait off as a real instructor.
 *
 * Replacing it is one import and one <Image />:
 *
 *   import { Image } from 'astro:assets';
 *   import photo from '@/assets/lecon-angers.jpg';
 *   <Image src={photo} alt={media.alt} widths={[480, 960]} loading="lazy" />
 *
 * `astro:assets` is mandatory here: invariant I3 scans the source text and fails
 * the suite on any raw image element in src/ — including one written inside a
 * comment, which is why this sentence describes it instead of showing it.
 */
interface Props {
  media: MediaSlotData;
  /** Art direction is shown on screen for the hero, hidden for repeated portraits. */
  showBrief?: boolean;
  class?: string;
}

const { media, showBrief = false, class: className = '' } = Astro.props;
---

<figure
  class:list={[
    'relative overflow-hidden rounded-(--radius-base) border border-dashed border-(--color-border) bg-white',
    className,
  ]}
  style={`aspect-ratio: ${media.ratio};`}
>
  <div class="absolute inset-0 flex flex-col justify-between gap-4 p-5">
    <span
      class="self-start rounded-full bg-ink px-3 py-1 text-xs font-medium tracking-wide text-white uppercase"
      >Emplacement photo</span
    >

    {
      showBrief && (
        <figcaption class="text-sm text-muted-foreground">
          <p class="font-medium text-ink">Direction artistique</p>
          <p class="mt-1">{media.brief}</p>
          <p class="mt-3 text-xs">
            Ratio {media.ratio} · alt : « {media.alt} »
          </p>
        </figcaption>
      )
    }
  </div>
</figure>
