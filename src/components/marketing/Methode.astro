---
import { autoecole } from '@/lib/autoecole';
import SectionHeading from './SectionHeading.astro';

const { methode } = autoecole;
---

<section id="methode" class="section-space bg-surface scroll-mt-20">
  <div class="container-shell">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="Méthode"
          title="Ce qu’on fait, concrètement, entre l’inscription et l’examen."
          lead={methode.intro}
          class="mb-0"
        />
      </div>

      <!-- No cards: this is a reference list, not six things to choose between. -->
      <dl class="lg:col-span-7">
        {
          methode.items.map((item, index) => (
            <div
              class:list={[
                'grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 py-5',
                index > 0 && 'border-t border-(--color-border)',
              ]}
            >
              <span
                aria-hidden="true"
                class="row-span-2 mt-0.5 font-heading text-sm font-semibold text-brand tabular-nums"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <dt class="font-heading text-base font-semibold text-ink">{item.title}</dt>
              <dd class="text-[0.95rem] text-muted-foreground">{item.description}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
