---
import { site } from '@/config/site.config';
import { autoecole } from '@/lib/autoecole';

const { formations, horaires, aConfirmer } = autoecole;
const { address } = site.contact;
const phoneHref = `tel:${site.contact.phone.replace(/\s/g, '')}`;
const year = new Date().getFullYear();
---

<footer class="bg-ink text-white/70">
  <div class="container-shell border-t border-white/10 py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="flex items-center gap-2.5">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="size-7 shrink-0 text-white">
            <path d="M9.5 3 6 21" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
            ></path>
            <path
              d="M15.5 3 18.5 21"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-dasharray="3 3.5"></path>
          </svg>
          <span class="font-heading text-lg font-semibold text-white">{site.name}</span>
        </div>

        <address class="mt-5 text-sm not-italic">
          {address.street}<br />
          {address.postalCode} {address.city}
        </address>

        <p class="mt-4 text-sm">
          <a href={phoneHref} class="text-white no-underline hover:underline">{site.contact.phone}</a
          ><br />
          <a href={`mailto:${site.contact.email}`} class="no-underline hover:text-white"
            >{site.contact.email}</a
          >
        </p>
      </div>

      <div class="lg:col-span-3">
        <h2 class="font-heading text-sm font-semibold tracking-wide text-white uppercase">
          Formations
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            formations.map((formation) => (
              <li>
                <a href="#formations" class="no-underline hover:text-white">
                  {formation.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h2 class="font-heading text-sm font-semibold tracking-wide text-white uppercase">
          Le site
        </h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            site.nav.main.map((item) => (
              <li>
                <a href={item.href} class="no-underline hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li><a href="/contact/" class="no-underline hover:text-white">Page contact</a></li>
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h2 class="font-heading text-sm font-semibold tracking-wide text-white uppercase">
          Horaires
        </h2>
        <ul class="mt-4 space-y-2 text-sm">
          {
            horaires.map((creneau) => (
              <li class="flex justify-between gap-3">
                <span>{creneau.jours}</span>
                <span class="text-right text-white/50">{creneau.heures}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-6 text-xs sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.legalName} — {aConfirmer.agrement}</p>

      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          site.nav.footer.map((item) => (
            <li>
              <a href={item.href} class="no-underline hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
